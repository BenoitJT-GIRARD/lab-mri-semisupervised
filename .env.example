# Copy this file to `.env`, then fill in what you need. Nothing here is required: the
# defaults keep every path inside the repository.

# --- Where the dataset lives ---
# The pipeline reads about 1300 images per pre-training epoch. On a synchronised drive
# (Google Drive, OneDrive) that starves the GPU, so point this at a local disk.
# Default: <repository>/data
MRI_DATA_DIR=
